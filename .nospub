{
    "release_globs": [
        "Config/**",
        "*.nosplugin",
        "Include/**",
        "Assets/**",
        "Shaders/*.{hlsl,glsl,frag,vert,spv}",
        "Binaries/*.{dll,dylib,so,exe}",
        "*.bat"
    ],
    "trigger_publish_globs": [
        "Source/**",
        "CMakeLists.txt"
    ]
}
